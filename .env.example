# Used by docker-compose (build args for the frontend, Neo4j password) and by the data pipeline.
# Copy to .env and replace the placeholders. Use the same password in VulLink-API/.env and VulLink-Visualizer/.env.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Frontend (baked into the build)
REACT_APP_BACKEND_URL=http://localhost:8001/api/v1
REACT_APP_NEO4J_URL=bolt://localhost:7687
REACT_APP_NEO4J_USER=neo4j
REACT_APP_NEO4J_PASSWORD=change-me

# Host port of the API (8000 is often taken by other local services)
BACKEND_PORT=8001

# Data source API keys (free): https://nvd.nist.gov/developers/request-an-api-key
# and your Wordfence account (Wordfence Intelligence API key)
NVD_API_KEY=
WORDFENCE_API_KEY=

# NVD scope: "wordpress" (WordPress + hosting stack only) or "all"
NVD_SCOPE=wordpress
NVD_STACK_PRODUCTS=php:php,oracle:mysql,mariadb:mariadb,apache:http_server,f5:nginx,nginx:nginx,litespeedtech:openlitespeed,litespeedtech:litespeed_web_server,litespeed_technologies:litespeed_web_server
